APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Use https:// and your real host in production to avoid mixed-content (http AJAX on https pages).
APP_URL=http://localhost

# Comma-separated proxy IPs, or * to trust X-Forwarded-* from the immediate client (typical behind Cloudflare / a load balancer).
TRUSTED_PROXIES=*

APP_LOCALE=en

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# Host / PHPUnit: DB where PHP runs (often 127.0.0.1). Docker app container ignores this for DB_HOST and uses DOCKER_DB_HOST (default: mysql).
DB_HOST=127.0.0.1
# Optional: MySQL hostname from inside Docker (Compose service name). Unset = mysql.
# DOCKER_DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# DB_URL=  # optional; when set, Laravel may prefer it over DB_* (still set MYSQL_*-backed vars for the mysql service)

# PHPUnit uses in-memory SQLite (see phpunit.xml).

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Use `reverb` when running `php artisan reverb:start` (see composer.json `dev` script) or the Docker `reverb` service.
# Tests use `null` via phpunit.xml.
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=local-app-id
REVERB_APP_KEY=local-app-key
REVERB_APP_SECRET=local-app-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
# Set false in production (disables Pusher/Echo console noise in browsers).
VITE_REVERB_DEBUG=true
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Only used when CACHE_STORE=memcached.
MEMCACHED_HOST=127.0.0.1

# Used when CACHE_STORE, SESSION_DRIVER, QUEUE_CONNECTION, or Reverb scaling use Redis.
# The bundled docker-compose.yml does not start Redis; add a redis service (or install phpredis) if you need these drivers.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Compose-only: hostname for the `reverb` service on the Docker network (default reverb). Not read by PHP `env()`.
# DOCKER_REVERB_HOST=reverb

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Docker Compose (docker-compose.yml) ---
# DOCKER_DB_HOST / DOCKER_REVERB_HOST are Compose interpolation variables only (see environment: blocks in docker-compose.yml), not Laravel config keys.
# App/queue containers force REVERB_PORT=8015 for HTTP broadcasts to the `reverb` service (see docker-compose.yml).
# REVERB_PORT here still controls the host port mapping on the reverb service (${REVERB_PORT:-8015}:8015) and should match VITE_REVERB_PORT in the browser (e.g. 8080 -> map host 8080 to container 8015, set VITE_REVERB_PORT=8080).
# The app service reads DB_* and MYSQL_ROOT_PASSWORD via Compose; DB_HOST inside the container is DOCKER_DB_HOST (default mysql).
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=http://localhost:8011
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=app
# DB_USERNAME=laravel
# DB_PASSWORD=secret
# MYSQL_ROOT_PASSWORD=secret
# REDIS_HOST=redis
# REDIS_PORT=6379
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
# APP_PORT=8011
# MYSQL_PORT=8012
# PHP_BUILD_IMAGE=mirror.gcr.io/library/php:8.4-cli
# PHP_RUNTIME_IMAGE=mirror.gcr.io/library/php:8.4-apache
