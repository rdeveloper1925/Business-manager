APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Use https:// and your real host in production to avoid mixed-content (http AJAX on https pages).
APP_URL=http://localhost

# Comma-separated proxy IPs, or * to trust X-Forwarded-* from the immediate client (typical behind Cloudflare / a load balancer).
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Primary Postgres DSN (used by config/database.php `pgsql.url`). Example: postgresql://user:pass@host:5432/dbname?sslmode=require
PG_CONNECTION=
# When PG_CONNECTION is empty, you can use discrete settings (and optional DB_URL) instead.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# DB_URL=  # optional alternative to PG_CONNECTION for the same `pgsql.url` slot
# DB_SSLMODE=prefer  # optional; Postgres sslmode (prefer, require, disable, …)

# PHPUnit uses in-memory SQLite (see phpunit.xml).

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Use `reverb` when running `php artisan reverb:start` (see composer.json `dev` script) or the Docker `reverb` service.
# Tests use `null` via phpunit.xml.
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=local-app-id
REVERB_APP_KEY=local-app-key
REVERB_APP_SECRET=local-app-secret
REVERB_HOST=localhost
# Client/browser port (Vite `VITE_REVERB_*`, Echo). Local `reverb:start` often uses 8080.
REVERB_PORT=8080
# Reverb server bind port (`config/reverb.php` servers.reverb.port). Keep in sync with `php artisan reverb:start --port`.
REVERB_SERVER_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
# Set false in production (disables Pusher/Echo console noise in browsers).
VITE_REVERB_DEBUG=true
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
QUEUE_RETRY_AFTER=420

CACHE_STORE=redis
# CACHE_PREFIX=

# Only used when CACHE_STORE=memcached.
MEMCACHED_HOST=127.0.0.1

# Used when CACHE_STORE, SESSION_DRIVER, QUEUE_CONNECTION, or Reverb scaling use Redis.
# Redis is the default for cache/session/queue. Switch back to database drivers only as a fallback.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Compose-only: hostname for the `reverb` service on the Docker network (default reverb). Not read by PHP `env()`.
# DOCKER_REVERB_HOST=reverb

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Inertia SSR: enable only where `php artisan inertia:start-ssr` runs.
INERTIA_SSR_ENABLED=false
INERTIA_SSR_URL=http://127.0.0.1:13714

# --- Docker Compose (docker-compose.yml) ---
# Host port for the `app` service (bm-app) after `docker compose up` (build alone does not publish ports).
APP_PORT=8013
# Reverb: set `REVERB_SERVER_PORT` and published `REVERB_PORT` to the same value (defaults in compose are 8015 if unset).
# The `app`/`queue` services override `REVERB_PORT` to `REVERB_SERVER_PORT` so PHP reaches Reverb on the Docker network.
# Align `VITE_REVERB_HOST`/`VITE_REVERB_PORT` with whatever the browser uses (often localhost + published port).

